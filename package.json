{
  "name": "difff",
  "displayName": "difff",
  "description": "A minimal VS Code extension scaffold.",
  "version": "0.0.1",
  "publisher": "local-dev",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/takeshibaconsuzuki/difff.git"
  },
  "engines": {
    "vscode": "^1.138.0",
    "node": ">=24"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js"
  ],
  "contributes": {
    "commands": [
      {
        "command": "difff.helloWorld",
        "title": "Hello World",
        "category": "difff"
      }
    ]
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run check-types && npm run lint",
    "compile": "npm run check-types && node esbuild.mjs",
    "dev": "npm run check-types && node esbuild.mjs --dev",
    "vscode:prepublish": "npm run check && node esbuild.mjs --production",
    "pretest": "npm run compile",
    "test": "node test/run.mjs",
    "build": "vsce package --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/vscode": "1.138.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@vscode/vsce-sign@2.1.0": true
  }
}
